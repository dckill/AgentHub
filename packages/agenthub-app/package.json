    "expo-document-picker": "^55.0.13",
    "expo-file-system": "~55.0.0",
    "expo-font": "~55.0.0",
    "expo-glass-effect": "~55.0.0",
    "expo-haptics": "~55.0.0",
    "expo-image": "~55.0.0",
