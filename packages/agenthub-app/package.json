    "@react-navigation/native-stack": "^7.14.7",
    "@shopify/flash-list": "~2.3.0",
    "@shopify/react-native-skia": "~2.5.3",
    "@tauri-apps/api": "2.8.0",
    "@tauri-apps/cli": "^2.8.1",
    "axios": "^1.16.0",
    "color": "^5.0.0",
    "diff": "^8.0.2",
    "expo": "~55.0.8",
    "expo-application": "~55.0.0",
