# ============================================
# AgentHub Server — 单机公网生产配置示例
# ============================================
# 使用方式：
#   cp packages/agenthub-server/.env.production.example packages/agenthub-server/.env.production
#   修改域名和 secret 后运行：
#   pnpm --filter agenthub-server standalone:prod

# Standalone 单机模式：PGlite + 本地文件存储
DB_PROVIDER=pglite
DATA_DIR=./data
PGLITE_DIR=./data/pglite
PORT=13017
NODE_ENV=production

# 必须替换为强随机值；上线后不要随意更换，否则已有认证数据会失效。
AGENTHUB_MASTER_SECRET=replace-with-a-long-random-secret

# 必须替换为你的公网 HTTPS 域名，不要以 / 结尾。
PUBLIC_URL=https://agenthub.yzsd.asia:8443
AGENTHUB_SERVER_URL=https://agenthub.yzsd.asia:8443

# Web/浏览器客户端 CORS 与 Socket.IO Origin allowlist。
# 原生 Android/iOS 客户端通常没有 Origin，但 Web 客户端需要此项。
AGENTHUB_ALLOWED_ORIGINS=https://agenthub.yzsd.asia:8443,http://localhost:8091,http://127.0.0.1:8091

# 可选：Prometheus metrics。若不对公网开放，可只监听本机/内网防火墙。
METRICS_ENABLED=true
METRICS_PORT=9090

# 可选：生产建议保持关闭，只在排障时临时启用并同时设置 AGENTHUB_DEBUG_LOG_SECRET。
# DANGEROUSLY_LOG_TO_SERVER_FOR_AI_AUTO_DEBUGGING=false
# AGENTHUB_DEBUG_LOG_SECRET=replace-with-debug-secret
