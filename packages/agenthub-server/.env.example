# Copy to .env.dev and generate every secret independently. Never commit .env.dev.
DB_PROVIDER=pglite
AGENTHUB_MASTER_SECRET=<development-only-random-secret-at-least-32-characters>
PORT=13017
PUBLIC_URL=http://localhost:13017
AGENTHUB_SERVER_URL=http://localhost:13017
NODE_ENV=development

METRICS_ENABLED=true
METRICS_PORT=9090
DANGEROUSLY_LOG_TO_SERVER_FOR_AI_AUTO_DEBUGGING=true

# Production requires versioned, purpose-isolated keys instead of the master fallback:
# AGENTHUB_DATA_ENCRYPTION_KEY_VERSION=1
# AGENTHUB_DATA_ENCRYPTION_KEYS={"1":"<independent-random-secret-at-least-32-characters>"}
# AGENTHUB_TOKEN_KEY_VERSION=1
# AGENTHUB_TOKEN_KEYS={"1":"<different-random-secret-at-least-32-characters>"}
# LOCAL_FILE_SIGNING_SECRET=<third-independent-random-secret-at-least-32-characters>
