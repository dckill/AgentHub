# ============================================
# AgentHub Agent Remote — 环境变量配置
# ============================================
# 复制此文件为 .env 并修改为你的实际值
# cp .env.example .env

# 公网服务端地址（不要以 / 结尾）
# agenthub-cli、agenthub-agent 使用 AGENTHUB_SERVER_URL
# agenthub-app 使用 EXPO_PUBLIC_AGENTHUB_SERVER_URL（Expo 限制）
AGENTHUB_SERVER_URL=https://agenthub.yzsd.asia:8443

# Expo 应用专用（agenthub-app）
# 由于 Expo 限制，客户端必须使用 EXPO_PUBLIC_ 前缀
EXPO_PUBLIC_AGENTHUB_SERVER_URL=https://agenthub.yzsd.asia:8443
# Native 外部 E2EE 分享链接的 HTTPS origin；Web 在未设置时使用当前同源 HTTPS origin。
# 只有证书、Universal/App Links association 与目标部署均验证通过后才在正式 Native 包中启用。
# EXPO_PUBLIC_AGENTHUB_SHARE_ORIGIN=https://agenthub.example.com

# 服务端生产部署时还需要在 packages/agenthub-server/.env.production 中设置：
# NODE_ENV=production
# PORT=13017
# PUBLIC_URL=https://agenthub.yzsd.asia:8443
# AGENTHUB_ALLOWED_ORIGINS=https://agenthub.yzsd.asia:8443
# AGENTHUB_MASTER_SECRET=<强随机值>
#
# 可选账号资源配额（必须为正整数；非法值会回退安全默认）
# AGENTHUB_QUOTA_SESSIONS=10000
# AGENTHUB_QUOTA_MESSAGES=1000000
# AGENTHUB_QUOTA_MACHINES=1000
# AGENTHUB_QUOTA_ARTIFACTS=1000
# AGENTHUB_QUOTA_CREDENTIALS=100
# AGENTHUB_QUOTA_KV_KEYS=10000
# AGENTHUB_QUOTA_EXTERNAL_SHARES=50
